{%- comment -%}
  Frauen kontakt
  Venstre: overskrift, tekst og kontaktrækker (mail, Instagram, adresse …).
  Højre: kontaktformular med streg-felter og linjeknap.
{%- endcomment -%}

<div class="frauen-contact frauen-wrap" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="frauen-contact__text">
    <h1 class="frauen-heading">{{ section.settings.heading | default: page.title | escape }}</h1>
    {%- if section.settings.text != blank -%}
      <div class="frauen-body frauen-contact__body">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <dl class="frauen-contact__facts">
        {%- for block in section.blocks -%}
          <div class="frauen-contact__fact" {{ block.shopify_attributes }}>
            <dt class="frauen-label">{{ block.settings.label | escape }}</dt>
            <dd>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}">{{ block.settings.value | escape }}</a>
              {%- else -%}
                {{ block.settings.value | escape }}
              {%- endif -%}
            </dd>
          </div>
        {%- endfor -%}
      </dl>
    {%- endif -%}
  </div>

  {%- form 'contact', id: 'FrauenContact', class: 'frauen-contact__form' -%}
    {%- if form.posted_successfully? -%}
      <p class="frauen-body frauen-contact__message" tabindex="-1" autofocus>{{ section.settings.success | escape }}</p>
    {%- elsif form.errors -%}
      <p class="frauen-body frauen-contact__message" role="alert">{{ form.errors | default_errors }}</p>
    {%- endif -%}

    <div class="frauen-field">
      <label class="frauen-label frauen-field__label" for="FrauenContact-name">{{ section.settings.name_label | escape }}</label>
      <input class="frauen-field__input" id="FrauenContact-name" type="text" name="contact[{{ section.settings.name_label | escape }}]" autocomplete="name" value="{{ form.name }}">
    </div>
    <div class="frauen-field">
      <label class="frauen-label frauen-field__label" for="FrauenContact-email">{{ section.settings.email_label | escape }} *</label>
      <input class="frauen-field__input" id="FrauenContact-email" type="email" name="contact[email]" autocomplete="email" spellcheck="false" autocapitalize="off" required value="{%- if form.email != blank -%}{{ form.email }}{%- elsif customer -%}{{ customer.email }}{%- endif -%}">
    </div>
    {%- if section.settings.show_phone -%}
      <div class="frauen-field">
        <label class="frauen-label frauen-field__label" for="FrauenContact-phone">{{ section.settings.phone_label | escape }}</label>
        <input class="frauen-field__input" id="FrauenContact-phone" type="tel" name="contact[{{ section.settings.phone_label | escape }}]" autocomplete="tel" value="{{ form.phone }}">
      </div>
    {%- endif -%}
    <div class="frauen-field">
      <label class="frauen-label frauen-field__label" for="FrauenContact-body">{{ section.settings.message_label | escape }}</label>
      <textarea class="frauen-field__input" id="FrauenContact-body" name="contact[body]" rows="5">{{ form.body }}</textarea>
    </div>

    <button type="submit" class="frauen-btn frauen-btn--left frauen-btn--submit">
      <span class="frauen-btn__line"></span>
      <span class="frauen-btn__label">{{ section.settings.button_label | escape }}</span>
    </button>
  {%- endform -%}
</div>

<style>
  .frauen-contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: var(--frauen-gap);
    align-items: start;
    padding-top: var(--pt);
    padding-bottom: var(--pb);
  }
  .frauen-contact__text { padding-right: 96px; }
  .frauen-contact__body { margin-top: 24px; max-width: 554px; }
  .frauen-contact__body p { margin: 0 0 0.8em; }
  .frauen-contact__body p:last-child { margin-bottom: 0; }
  .frauen-contact__facts { margin: 48px 0 0; border-bottom: 1px solid rgba(28, 28, 26, 0.2); }
  .frauen-contact__fact {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 24px;
    padding: 20px 0;
    border-top: 1px solid rgba(28, 28, 26, 0.2);
  }
  .frauen-contact__fact dt { color: var(--frauen-muted); font-weight: 500; padding-top: 2px; }
  .frauen-contact__fact dd { margin: 0; font-weight: 300; font-size: 14px; line-height: 1.45; letter-spacing: 0.015em; }
  .frauen-contact__fact a { color: inherit; text-decoration: none; border-bottom: 1px solid transparent; transition: border-color 0.3s var(--frauen-ease); }
  @media (hover: hover) { .frauen-contact__fact a:hover { border-bottom-color: currentColor; } }

  .frauen-contact__form { display: grid; gap: 32px; }
  .frauen-contact__message { margin: 0; }
  .frauen-contact__form .frauen-btn { margin-top: 8px; }

  @media screen and (max-width: 989px) {
    .frauen-contact { grid-template-columns: 1fr; row-gap: 56px; }
    .frauen-contact__text { padding-right: 0; }
  }
  @media screen and (max-width: 749px) {
    .frauen-contact__fact { grid-template-columns: 1fr; gap: 6px; }
  }
</style>

{% schema %}
{
  "name": "Frauen kontakt",
  "tag": "section",
  "class": "frauen-contact-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Kontakt", "info": "Tom = sidens titel." },
    { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>En kort tekst om, hvordan man kontakter Frauen, står her.</p>" },
    { "type": "header", "content": "Formular" },
    { "type": "text", "id": "name_label", "label": "Navn", "default": "Navn" },
    { "type": "text", "id": "email_label", "label": "E-mail", "default": "E-mail" },
    { "type": "checkbox", "id": "show_phone", "label": "Vis telefonfelt", "default": false },
    { "type": "text", "id": "phone_label", "label": "Telefon", "default": "Telefon" },
    { "type": "text", "id": "message_label", "label": "Besked", "default": "Besked" },
    { "type": "text", "id": "button_label", "label": "Knap", "default": "Send" },
    { "type": "text", "id": "success", "label": "Tak-besked", "default": "Tak for din besked. Vi vender tilbage hurtigst muligt." },
    { "type": "header", "content": "Luft" },
    { "type": "range", "id": "padding_top", "label": "Luft over", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 83 },
    { "type": "range", "id": "padding_bottom", "label": "Luft under", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 160 }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Kontaktrække",
      "settings": [
        { "type": "text", "id": "label", "label": "Etiket", "default": "Mail" },
        { "type": "text", "id": "value", "label": "Tekst", "default": "hej@frauencph.com" },
        { "type": "url", "id": "link", "label": "Link", "info": "Fx mailto:hej@frauencph.com eller Instagram-linket." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Frauen kontakt",
      "blocks": [
        { "type": "fact", "settings": { "label": "Mail", "value": "Mailadresse" } },
        { "type": "fact", "settings": { "label": "Instagram", "value": "@frauencph" } },
        { "type": "fact", "settings": { "label": "Showroom", "value": "Adresse" } }
      ]
    }
  ]
}
{% endschema %}
