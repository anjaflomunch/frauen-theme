{%- comment -%}
  Frauen mosaik (custom made)
  Fire kolonner, ens afstand, felter i forskellige størrelser.
  Mønsteret gentages for hver 8 billeder. Går antallet ikke op, får de sidste
  billeder andre størrelser, så der aldrig er huller (computer: 4 kolonner,
  mobil: 2 kolonner med et stort billede og to små). Hvert billede er en blok med
  modelnavn og fra-pris. Klik åbner en mail med modelnavnet i emnefeltet,
  medmindre billedet har sit eget link.
{%- endcomment -%}

{{ 'frauen-card.css' | asset_url | stylesheet_tag }}

<div{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %} class="frauen-mosaic frauen-wrap" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  {%- if section.settings.heading != blank -%}
    <h2 class="frauen-heading frauen-mosaic__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  {%- liquid
    # Størrelser som kolonner x rækker. Hele grupper følger mønsteret på 8.
    assign pattern = '2x2,1x1,1x2,1x1,1x1,1x1,2x2,2x1' | split: ','
    assign total = section.blocks.size
    assign full = total | divided_by: 8 | floor | times: 8
    assign rest = total | minus: full
    case rest
      when 1
        assign tail = '4x2'
      when 2
        assign tail = '2x2,2x2'
      when 3
        assign tail = '2x2,1x2,1x2'
      when 4
        assign tail = '2x2,1x1,1x2,1x1'
      when 5
        assign tail = '2x2,1x1,1x2,1x1,4x2'
      when 6
        assign tail = '2x2,1x1,1x2,1x1,2x2,2x2'
      when 7
        assign tail = '2x2,1x1,1x2,1x1,2x2,1x2,1x2'
      else
        assign tail = ''
    endcase
    assign tail = tail | split: ','
    assign mobile_rest = total | modulo: 3
  -%}

  <div class="frauen-mosaic__grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign i = forloop.index0
        if i < full
          assign pos = i | modulo: 8
          assign size = pattern[pos]
        else
          assign k = i | minus: full
          assign size = tail[k]
        endif
        assign size_parts = size | split: 'x'

        # Mobil: stort billede, så to små. Står det sidste alene, bliver det bredt.
        assign mpos = i | modulo: 3
        if mpos == 0
          assign msize = '2x2'
        elsif mobile_rest == 2 and forloop.last
          assign msize = '2x1'
        else
          assign msize = '1x1'
        endif
        assign msize_parts = msize | split: 'x'

        assign link = block.settings.link
        if link == blank and section.settings.email != blank
          assign subject = section.settings.subject_prefix | append: ' ' | append: block.settings.title | strip | url_encode
          assign link = 'mailto:' | append: section.settings.email | append: '?subject=' | append: subject
        endif
      -%}
      <div
        class="frauen-mosaic__item"
        style="--cs: {{ size_parts[0] }}; --rs: {{ size_parts[1] }}; --mcs: {{ msize_parts[0] }}; --mrs: {{ msize_parts[1] }};"
        {{ block.shopify_attributes }}
      >
        {% render 'frauen-card',
          image: block.settings.image,
          title: block.settings.title,
          price: block.settings.price,
          url: link,
          class: 'frauen-card--fill',
          sizes: '(min-width: 750px) 50vw, 100vw'
        %}
      </div>
    {%- endfor -%}
  </div>
</div>

<style>
  .frauen-mosaic { padding-top: var(--pt); padding-bottom: var(--pb); }
  .frauen-mosaic__heading { margin-bottom: 32px; }
  .frauen-mosaic__grid {
    --col: calc((100vw - 2 * var(--frauen-gutter) - 3 * var(--frauen-gap)) / 4);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: calc(var(--col) * 412 / 330);
    grid-auto-flow: dense;
    gap: var(--frauen-gap);
  }
  .frauen-mosaic__item { min-width: 0; min-height: 0; grid-column: span var(--cs, 1); grid-row: span var(--rs, 1); }
  @media screen and (max-width: 749px) {
    .frauen-mosaic__grid {
      --col: calc((100vw - 2 * var(--frauen-gutter) - var(--frauen-gap)) / 2);
      grid-template-columns: repeat(2, 1fr);
      /* plads til navn og pris under hvert billede */
      grid-auto-rows: calc(var(--col) * 412 / 330 + 26px);
      row-gap: 24px;
    }
    .frauen-mosaic__item { grid-column: span var(--mcs, 1); grid-row: span var(--mrs, 1); }
  }
</style>

{% schema %}
{
  "name": "Frauen mosaik",
  "tag": "section",
  "class": "frauen-mosaic-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Overskrift (valgfri)" },
    { "type": "text", "id": "email", "label": "Mail til forespørgsler", "info": "Klik på et billede åbner en mail hertil med modelnavnet i emnefeltet." },
    { "type": "text", "id": "subject_prefix", "label": "Emnefelt starter med", "default": "Forespørgsel:" },
    { "type": "text", "id": "anchor", "label": "Anker (til links)", "info": "Fx produktion. Link hertil med /pages/om-frauen#produktion" },
    { "type": "header", "content": "Luft" },
    { "type": "range", "id": "padding_top", "label": "Luft over", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Luft under", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 160 }
  ],
  "blocks": [
    {
      "type": "piece",
      "name": "Custom made-jakke",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Billede" },
        { "type": "text", "id": "title", "label": "Modelnavn", "default": "Modelnavn" },
        { "type": "text", "id": "price", "label": "Pris", "default": "Fra pris", "info": "Fx \"Fra 4.500 kr.\"" },
        { "type": "url", "id": "link", "label": "Eget link (valgfrit)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Frauen mosaik",
      "blocks": [
        { "type": "piece" }, { "type": "piece" }, { "type": "piece" }, { "type": "piece" },
        { "type": "piece" }, { "type": "piece" }, { "type": "piece" }, { "type": "piece" }
      ]
    }
  ]
}
{% endschema %}
