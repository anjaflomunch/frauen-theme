{%- comment -%}
  Frauen mosaik (custom made)
  Fire kolonner, ens afstand, felter i forskellige størrelser.
  Mønsteret gentages for hver 8 billeder. Hvert billede er en blok med
  modelnavn og fra-pris. Klik åbner en mail med modelnavnet i emnefeltet,
  medmindre billedet har sit eget link.
{%- endcomment -%}

{{ 'frauen-card.css' | asset_url | stylesheet_tag }}

<div{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %} class="frauen-mosaic frauen-wrap" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  {%- if section.settings.heading != blank -%}
    <h2 class="frauen-heading frauen-mosaic__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  <div class="frauen-mosaic__grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign link = block.settings.link
        if link == blank and section.settings.email != blank
          assign subject = section.settings.subject_prefix | append: ' ' | append: block.settings.title | strip | url_encode
          assign link = 'mailto:' | append: section.settings.email | append: '?subject=' | append: subject
        endif
      -%}
      <div class="frauen-mosaic__item" {{ block.shopify_attributes }}>
        {% render 'frauen-card',
          image: block.settings.image,
          title: block.settings.title,
          price: block.settings.price,
          url: link,
          sizes: '(min-width: 750px) 50vw, 100vw'
        %}
      </div>
    {%- endfor -%}
  </div>
</div>

<style>
  .frauen-mosaic { padding-top: var(--pt); padding-bottom: var(--pb); }
  .frauen-mosaic__heading { margin-bottom: 32px; }
  .frauen-mosaic__grid {
    --col: calc((100vw - 2 * var(--frauen-gutter) - 3 * var(--frauen-gap)) / 4);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: calc(var(--col) * 412 / 330);
    grid-auto-flow: dense;
    gap: var(--frauen-gap);
  }
  .frauen-mosaic__item { min-width: 0; min-height: 0; }
  .frauen-mosaic__item:nth-child(8n + 1) { grid-column: span 2; grid-row: span 2; }
  .frauen-mosaic__item:nth-child(8n + 3) { grid-row: span 2; }
  .frauen-mosaic__item:nth-child(8n + 7) { grid-column: span 2; grid-row: span 2; }
  .frauen-mosaic__item:nth-child(8n + 8) { grid-column: span 2; }
  @media screen and (max-width: 749px) {
    .frauen-mosaic__grid {
      --col: calc((100vw - 2 * var(--frauen-gutter) - var(--frauen-gap)) / 2);
      grid-template-columns: repeat(2, 1fr);
    }
    .frauen-mosaic__item:nth-child(8n + 3) { grid-row: span 1; }
  }
</style>

{% schema %}
{
  "name": "Frauen mosaik",
  "tag": "section",
  "class": "frauen-mosaic-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Overskrift (valgfri)" },
    { "type": "text", "id": "email", "label": "Mail til forespørgsler", "info": "Klik på et billede åbner en mail hertil med modelnavnet i emnefeltet." },
    { "type": "text", "id": "subject_prefix", "label": "Emnefelt starter med", "default": "Forespørgsel:" },
    { "type": "text", "id": "anchor", "label": "Anker (til links)", "info": "Fx produktion. Link hertil med /pages/om-frauen#produktion" },
    { "type": "header", "content": "Luft" },
    { "type": "range", "id": "padding_top", "label": "Luft over", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Luft under", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 160 }
  ],
  "blocks": [
    {
      "type": "piece",
      "name": "Custom made-jakke",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Billede" },
        { "type": "text", "id": "title", "label": "Modelnavn", "default": "Modelnavn" },
        { "type": "text", "id": "price", "label": "Pris", "default": "Fra pris", "info": "Fx \"Fra 4.500 kr.\"" },
        { "type": "url", "id": "link", "label": "Eget link (valgfrit)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Frauen mosaik",
      "blocks": [
        { "type": "piece" }, { "type": "piece" }, { "type": "piece" }, { "type": "piece" },
        { "type": "piece" }, { "type": "piece" }, { "type": "piece" }, { "type": "piece" }
      ]
    }
  ]
}
{% endschema %}
