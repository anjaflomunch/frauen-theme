{%- comment -%}
  Frauen portræt (Om Frauen)
  Billede til venstre. Til højre overskrift + tekst øverst og et citat
  nederst, der flugter med billedets bund.
{%- endcomment -%}

<div class="frauen-portrait frauen-wrap{% if section.settings.image_right %} frauen-portrait--right{% endif %}{% if section.settings.quote == blank %} frauen-portrait--no-quote{% endif %}" style="--img-w: {{ section.settings.image_width }}%; --pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="frauen-portrait__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 1800
        | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', widths: '600, 900, 1200, 1800', alt: section.settings.image.alt
      }}
    {%- else -%}
      {{ 'image' | placeholder_svg_tag }}
    {%- endif -%}
  </div>

  <div class="frauen-portrait__text">

    <div>
      {%- if section.settings.heading != blank -%}
        <h2 class="frauen-heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="frauen-body frauen-portrait__body">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    {%- if section.settings.quote != blank -%}
      <blockquote class="frauen-statement frauen-portrait__quote">{{ section.settings.quote }}</blockquote>
    {%- endif -%}
  </div>
</div>

<style>
  .frauen-portrait {
    display: grid;
    grid-template-columns: var(--img-w, 49%) 1fr;
    column-gap: 55px;
    padding-top: var(--pt);
    padding-bottom: var(--pb);
  }
  .frauen-portrait--right { grid-template-columns: 1fr var(--img-w, 49%); }
  .frauen-portrait--right .frauen-portrait__media { order: 2; }
  .frauen-portrait__media { position: relative; align-self: start; aspect-ratio: 684 / 848; overflow: hidden; background: #d9d8d3; }
  .frauen-portrait__media img,
  .frauen-portrait__media svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .frauen-portrait__text { display: flex; flex-direction: column; justify-content: space-between; gap: 48px; }
  /* Uden citat står teksten øverst */
  .frauen-portrait--no-quote .frauen-portrait__text { justify-content: flex-start; }
  .frauen-portrait__body { max-width: 554px; }
  .frauen-portrait__quote { margin: 0; padding: 0; border: 0; color: inherit; max-width: 494px; font-style: italic; }
  .frauen-portrait__quote p { margin: 0; }
  .frauen-portrait__body { margin-top: 24px; }
  .frauen-portrait__body p { margin: 0 0 0.8em; }
  .frauen-portrait__body p:last-child { margin-bottom: 0; }
  @media screen and (max-width: 749px) {
    .frauen-portrait, .frauen-portrait--right { grid-template-columns: 1fr; row-gap: 32px; }
    .frauen-portrait--right .frauen-portrait__media { order: 0; }
    .frauen-portrait .frauen-statement { font-size: 21px; }
  }
</style>

{% schema %}
{
  "name": "Frauen portræt",
  "tag": "section",
  "class": "frauen-portrait-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Billede" },
    { "type": "range", "id": "image_width", "label": "Billedets bredde", "min": 30, "max": 60, "step": 1, "unit": "%", "default": 40 },
    { "type": "checkbox", "id": "image_right", "label": "Billede til højre", "default": false },
    { "type": "richtext", "id": "quote", "label": "Citat", "info": "Står nederst ved billedets bund. Kan være tomt." },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Emilie – founder & designer" },
    { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>En tekst om Emilie.</p>" },
    { "type": "header", "content": "Luft" },
    { "type": "range", "id": "padding_top", "label": "Luft over", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Luft under", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 160 }
  ],
  "presets": [{ "name": "Frauen portræt" }]
}
{% endschema %}
