{%- comment -%}
  Frauen billede/video (hero til undersider)
  Billede eller video i fuld bredde, fx øverst på Custom made eller Showroom.
  Video afspilles automatisk uden lyd i loop. Valgfri lydknap og valgfri tekst nederst.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  case s.height
    when 'screen'
      assign height_css = 'height: calc(100svh - var(--frauen-header-height));'
    when 'tall'
      assign height_css = 'aspect-ratio: 1440 / 810;'
    else
      assign height_css = 'aspect-ratio: 1392 / 636;'
  endcase
-%}

<div
  {% if s.anchor != blank %}id="{{ s.anchor | handleize }}"{% endif %}
  class="frauen-media{% if s.full_bleed %} frauen-media--bleed{% else %} frauen-wrap{% endif %}"
  style="--pt: {{ s.padding_top }}px; --pb: {{ s.padding_bottom }}px; --overlay: {{ s.overlay | divided_by: 100.0 }};"
>
  <div class="frauen-media__frame" style="{{ height_css }}">
    {%- if s.media_type == 'video' and s.video != blank -%}
      {{
        s.video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          playsinline: true,
          controls: false,
          preload: 'metadata',
          class: 'frauen-media__asset'
      }}
      {%- if s.show_sound -%}
        <button type="button" class="frauen-media__sound" data-sound aria-pressed="false" data-on="{{ s.sound_on_label | escape }}" data-off="{{ s.sound_off_label | escape }}">
          {{- s.sound_off_label | escape -}}
        </button>
      {%- endif -%}
    {%- elsif s.image != blank -%}
      {{
        s.image
        | image_url: width: 3000
        | image_tag:
          class: 'frauen-media__asset',
          loading: 'eager',
          sizes: '100vw',
          widths: '750, 1100, 1500, 2000, 2500, 3000',
          alt: s.image.alt
      }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'frauen-media__asset' }}
    {%- endif -%}

    {%- if s.heading != blank or s.text != blank -%}
      <div class="frauen-media__caption">
        {%- if s.heading != blank -%}
          {%- if s.is_page_heading -%}
            <h1 class="frauen-media__title">{{ s.heading | escape }}</h1>
          {%- else -%}
            <h2 class="frauen-media__title">{{ s.heading | escape }}</h2>
          {%- endif -%}
        {%- endif -%}
        {%- if s.text != blank -%}<div class="frauen-body frauen-media__text">{{ s.text }}</div>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  document.querySelectorAll('.frauen-media [data-sound]').forEach((btn) => {
    if (btn.dataset.bound) return;
    btn.dataset.bound = '1';
    const video = btn.closest('.frauen-media__frame').querySelector('video');
    if (!video) return;
    btn.addEventListener('click', () => {
      video.muted = !video.muted;
      if (!video.muted) video.play();
      btn.setAttribute('aria-pressed', String(!video.muted));
      btn.textContent = video.muted ? btn.dataset.off : btn.dataset.on;
    });
  });
</script>

<style>
  .frauen-media { padding-top: var(--pt); padding-bottom: var(--pb); }
  .frauen-media__frame { position: relative; overflow: hidden; background: #d9d8d3; color: var(--frauen-bg); }
  .frauen-media__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #000;
    opacity: var(--overlay, 0);
    pointer-events: none;
  }
  .frauen-media__asset,
  .frauen-media__frame > video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .frauen-media__caption { position: absolute; left: 24px; bottom: 40px; z-index: 1; max-width: 640px; }
  /* Samme udtryk som taglinen i forsidens hero ("Made to love …") */
  .frauen-media__title {
    margin: 0;
    font-family: var(--frauen-font-heading);
    font-weight: 400;
    font-size: 20px;
    line-height: 1.1;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  .frauen-media--bleed .frauen-media__caption { left: var(--frauen-gutter); }
  .frauen-media__text { margin-top: 12px; }
  .frauen-media__text p { margin: 0; }
  .frauen-media__sound {
    position: absolute;
    right: var(--frauen-gutter);
    bottom: 40px;
    z-index: 1;
    padding: 0 0 6px;
    background: none;
    border: 0;
    border-bottom: 1px solid currentColor;
    color: inherit;
    cursor: pointer;
    font-family: var(--frauen-font-body);
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  @media screen and (max-width: 749px) {
    .frauen-media__frame[style*='aspect-ratio'] { aspect-ratio: 4 / 5 !important; }
    .frauen-media__caption { left: var(--frauen-gutter); right: var(--frauen-gutter); bottom: 32px; }
    .frauen-media__title { font-size: 15px; }
    .frauen-media__sound { bottom: 32px; }
  }
</style>

{% schema %}
{
  "name": "Frauen billede/video",
  "tag": "section",
  "class": "frauen-media-section",
  "settings": [
    {
      "type": "select",
      "id": "media_type",
      "label": "Type",
      "options": [
        { "value": "image", "label": "Billede" },
        { "value": "video", "label": "Video" }
      ],
      "default": "video"
    },
    { "type": "video", "id": "video", "label": "Video", "info": "Upload til Shopify. Afspilles automatisk uden lyd i loop." },
    { "type": "image_picker", "id": "image", "label": "Billede", "info": "Bruges, når typen er Billede." },
    {
      "type": "select",
      "id": "height",
      "label": "Højde",
      "options": [
        { "value": "screen", "label": "Hele skærmen" },
        { "value": "tall", "label": "Høj (16:9)" },
        { "value": "wide", "label": "Bred (som showroom-billedet)" }
      ],
      "default": "screen"
    },
    { "type": "checkbox", "id": "full_bleed", "label": "Helt ud til kanten", "default": true },
    { "type": "range", "id": "overlay", "label": "Overlay", "min": 0, "max": 60, "step": 5, "unit": "%", "default": 0, "info": "Gør billedet mørkere, hvis der står tekst ovenpå." },
    { "type": "header", "content": "Tekst (valgfri)" },
    { "type": "text", "id": "heading", "label": "Overskrift", "info": "Står nederst til venstre i samme stil som 'Made to love …' på forsiden." },
    { "type": "checkbox", "id": "is_page_heading", "label": "Sidens hovedoverskrift", "default": false, "info": "Slå kun til, hvis siden ikke har en anden hovedoverskrift." },
    { "type": "richtext", "id": "text", "label": "Tekst" },
    { "type": "header", "content": "Lyd" },
    { "type": "checkbox", "id": "show_sound", "label": "Vis lydknap", "default": false },
    { "type": "text", "id": "sound_off_label", "label": "Knap: slå lyd til", "default": "Lyd til" },
    { "type": "text", "id": "sound_on_label", "label": "Knap: slå lyd fra", "default": "Lyd fra" },
    { "type": "text", "id": "anchor", "label": "Anker (til links)" },
    { "type": "header", "content": "Luft" },
    { "type": "range", "id": "padding_top", "label": "Luft over", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Luft under", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "Frauen billede/video" }]
}
{% endschema %}
