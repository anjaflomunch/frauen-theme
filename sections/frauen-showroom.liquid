{%- comment -%}
  Frauen showroom (forside og showroom-siden)
  Uden overskrift, tekst og knap er det bare et stort billede/video.
  Overskrift og adresse, linjeknap (fx "Book din tid") og et stort billede
  eller en video i fuld bredde under.
{%- endcomment -%}

<div{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %} class="frauen-showroom frauen-wrap" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  {%- if section.settings.heading != blank -%}
    <h2 class="frauen-heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  {%- if section.settings.text != blank -%}
    <div class="frauen-body frauen-showroom__text">{{ section.settings.text }}</div>
  {%- endif -%}

  {%- if section.settings.button_label != blank -%}
    <a href="{{ section.settings.button_link | default: '#' }}" class="frauen-btn frauen-showroom__btn">
      <span class="frauen-btn__line"></span>
      <span class="frauen-btn__label">{{ section.settings.button_label | escape }}</span>
    </a>
  {%- endif -%}

  <div class="frauen-showroom__media">
    {%- if section.settings.media_type == 'video' and section.settings.video != blank -%}
      {{
        section.settings.video
        | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata'
      }}
    {%- elsif section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 3000
        | image_tag:
          loading: 'lazy',
          sizes: '100vw',
          widths: '750, 1100, 1500, 2000, 2500, 3000',
          alt: section.settings.image.alt
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {%- endif -%}
  </div>
</div>

<style>
  .frauen-showroom { padding-top: var(--pt); padding-bottom: var(--pb); }
  .frauen-showroom__text { margin-top: 12px; max-width: 640px; }
  .frauen-showroom__text p { margin: 0; }
  .frauen-showroom__btn { margin-top: 4px; }
  .frauen-showroom > * + .frauen-showroom__media { margin-top: 40px; }
  .frauen-showroom__media {
    position: relative;
    aspect-ratio: 1392 / 636;
    overflow: hidden;
    background: #d9d8d3;
  }
  .frauen-showroom__media > * {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media screen and (max-width: 749px) {
    .frauen-showroom__media { aspect-ratio: 4 / 5; }
  }
</style>

{% schema %}
{
  "name": "Frauen showroom",
  "tag": "section",
  "class": "frauen-showroom-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Besøg vores showroom" },
    { "type": "richtext", "id": "text", "label": "Tekst / adresse", "default": "<p>Adresse og åbningstider</p>" },
    { "type": "text", "id": "button_label", "label": "Knaptekst", "default": "Book din tid" },
    { "type": "url", "id": "button_link", "label": "Knaplink", "info": "Fx mailto:hej@frauencph.com eller et booking-link." },
    {
      "type": "select",
      "id": "media_type",
      "label": "Billede eller video",
      "options": [
        { "value": "image", "label": "Billede" },
        { "value": "video", "label": "Video" }
      ],
      "default": "image"
    },
    { "type": "image_picker", "id": "image", "label": "Billede" },
    { "type": "video", "id": "video", "label": "Video" },
    { "type": "text", "id": "anchor", "label": "Anker (til links)", "info": "Fx produktion. Link hertil med /pages/om-frauen#produktion" },
    { "type": "header", "content": "Luft" },
    { "type": "range", "id": "padding_top", "label": "Luft over", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Luft under", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 160 }
  ],
  "presets": [{ "name": "Frauen showroom" }]
}
{% endschema %}
