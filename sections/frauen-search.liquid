{%- comment -%}
  Frauen søgning
  Søgefelt øverst. Produkter vises som Frauen-kort, sider og artikler som rækker.
{%- endcomment -%}

{{ 'frauen-card.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign per_page = section.settings.per_page
-%}

<div class="frauen-search frauen-wrap" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <h1 class="frauen-heading">{{ section.settings.heading | escape }}</h1>

  <form action="{{ routes.search_url }}" method="get" role="search" class="frauen-search__form">
    <label class="visually-hidden" for="FrauenSearch">{{ section.settings.placeholder | escape }}</label>
    <input
      id="FrauenSearch"
      class="frauen-field__input frauen-search__input"
      type="search"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="{{ section.settings.placeholder | escape }}"
      autocomplete="off"
      {% unless search.performed %}autofocus{% endunless %}
    >
    <input type="hidden" name="options[prefix]" value="last">
    <button type="submit" class="frauen-search__submit">{{ section.settings.button_label | escape }}</button>
  </form>

  {%- if search.performed -%}
    {%- paginate search.results by per_page -%}
      <p class="frauen-label frauen-search__count">
        {%- if search.results_count == 0 -%}
          {{ section.settings.no_results | replace: '[terms]', search.terms | escape }}
        {%- else -%}
          {{ search.results_count }} {{ section.settings.results_label | escape }} "{{ search.terms | escape }}"
        {%- endif -%}
      </p>

      {%- if search.results_count > 0 -%}
        {%- liquid
          assign products = search.results | where: 'object_type', 'product'
          assign others = search.results | where: 'object_type', 'page'
          assign articles = search.results | where: 'object_type', 'article'
        -%}

        {%- if products.size > 0 -%}
          <div class="frauen-search__grid">
            {%- for item in products -%}
              <div class="frauen-search__item">
                {% render 'frauen-card', product: item, sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw' %}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if others.size > 0 or articles.size > 0 -%}
          <ul class="frauen-search__list" role="list">
            {%- for item in others -%}
              <li>
                <a href="{{ item.url }}" class="frauen-search__row">
                  <span class="frauen-search__row-title">{{ item.title | escape }}</span>
                  <span class="frauen-label frauen-search__row-type">{{ section.settings.page_label | escape }}</span>
                </a>
              </li>
            {%- endfor -%}
            {%- for item in articles -%}
              <li>
                <a href="{{ item.url }}" class="frauen-search__row">
                  <span class="frauen-search__row-title">{{ item.title | escape }}</span>
                  <span class="frauen-label frauen-search__row-type">{{ item.blog.title | escape }}</span>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if paginate.pages > 1 -%}
          <nav class="frauen-pagination frauen-label" aria-label="Sider">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">Forrige</a>{%- else -%}<span></span>{%- endif -%}
            <span>{{ paginate.current_page }}/{{ paginate.pages }}</span>
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Næste</a>{%- else -%}<span></span>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</div>

<style>
  .frauen-search { padding-top: var(--pt); padding-bottom: var(--pb); }
  .frauen-search__form {
    display: flex;
    align-items: flex-end;
    gap: 24px;
    max-width: 684px;
    margin-top: 40px;
    border-bottom: 1px solid rgba(28, 28, 26, 0.3);
    transition: border-color 0.3s var(--frauen-ease);
  }
  .frauen-search__form:focus-within { border-bottom-color: var(--frauen-ink); }
  .frauen-search__input { border-bottom: 0; font-size: 25px; line-height: 1.3; padding-bottom: 12px; }
  .frauen-search__input::-webkit-search-cancel-button { -webkit-appearance: none; }
  .frauen-search__submit {
    flex: 0 0 auto;
    padding: 0 0 14px;
    background: none;
    border: 0;
    color: inherit;
    cursor: pointer;
    font-family: var(--frauen-font-body);
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .frauen-search__count { margin: 24px 0 0; color: var(--frauen-muted); }
  .frauen-search__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--frauen-gap);
    margin-top: 40px;
  }
  .frauen-search__item { aspect-ratio: 4 / 5; min-width: 0; }
  .frauen-search__list { list-style: none; margin: 80px 0 0; padding: 0; border-bottom: 1px solid rgba(28, 28, 26, 0.2); }
  .frauen-search__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    padding: 20px 0;
    border-top: 1px solid rgba(28, 28, 26, 0.2);
    color: inherit;
    text-decoration: none;
  }
  .frauen-search__row-title { font-weight: 300; font-size: 16px; transition: opacity 0.3s var(--frauen-ease); }
  .frauen-search__row-type { color: var(--frauen-muted); }
  @media (hover: hover) { .frauen-search__row:hover .frauen-search__row-title { opacity: 0.6; } }

  .frauen-pagination { display: flex; justify-content: space-between; margin-top: 40px; }
  .frauen-pagination a { color: inherit; text-decoration: none; }

  @media screen and (max-width: 989px) { .frauen-search__grid { grid-template-columns: repeat(2, 1fr); } }
  @media screen and (max-width: 749px) {
    .frauen-search__grid { grid-template-columns: 1fr; }
    .frauen-search__input { font-size: 21px; }
  }
</style>

{% schema %}
{
  "name": "Frauen søgning",
  "tag": "section",
  "class": "frauen-search-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Søg" },
    { "type": "text", "id": "placeholder", "label": "Tekst i feltet", "default": "Hvad leder du efter?" },
    { "type": "text", "id": "button_label", "label": "Knap", "default": "Søg" },
    { "type": "text", "id": "results_label", "label": "Antal resultater", "default": "resultater for" },
    { "type": "text", "id": "no_results", "label": "Ingen resultater", "default": "Ingen resultater for \"[terms]\"", "info": "[terms] erstattes af det, der er søgt på." },
    { "type": "text", "id": "page_label", "label": "Etiket for sider", "default": "Side" },
    { "type": "range", "id": "per_page", "label": "Resultater pr. side", "min": 6, "max": 48, "step": 3, "default": 24 },
    { "type": "header", "content": "Luft" },
    { "type": "range", "id": "padding_top", "label": "Luft over", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 83 },
    { "type": "range", "id": "padding_bottom", "label": "Luft under", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 160 }
  ],
  "enabled_on": { "templates": ["search"] },
  "presets": [{ "name": "Frauen søgning" }]
}
{% endschema %}
