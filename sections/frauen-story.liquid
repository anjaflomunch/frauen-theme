{%- comment -%}
  Frauen jakkens historie (produktside)
  Tekst og faktarækker til venstre, billede til højre.
  Felterne kan kobles til metafelter på produktet, så hver jakke får sin egen historie.
{%- endcomment -%}

{%- if section.settings.text != blank or section.settings.image != blank or section.blocks.size > 0 -%}
<div{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %} class="frauen-story frauen-wrap" style="--pb: {{ section.settings.padding_bottom }}px;">
  <div class="frauen-story__text">
    <div>
      {%- if section.settings.heading != blank -%}
        <h2 class="frauen-heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="frauen-body frauen-story__body">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <dl class="frauen-story__facts">
        {%- for block in section.blocks -%}
          {%- if block.settings.value != blank -%}
            <div class="frauen-story__fact" {{ block.shopify_attributes }}>
              <dt class="frauen-label">{{ block.settings.label | escape }}</dt>
              <dd>{{ block.settings.value | escape }}</dd>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </dl>
    {%- endif -%}
  </div>

  <div class="frauen-story__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 1800
        | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', widths: '600, 900, 1200, 1800'
      }}
    {%- else -%}
      {{ 'image' | placeholder_svg_tag }}
    {%- endif -%}
  </div>
</div>

<style>
  .frauen-story {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--frauen-gap);
    padding-bottom: var(--pb);
  }
  .frauen-story__text { display: flex; flex-direction: column; justify-content: space-between; gap: 48px; }
  .frauen-story__body { margin-top: 24px; max-width: 630px; }
  .frauen-story__body p { margin: 0 0 0.8em; }
  .frauen-story__facts { margin: 0; border-bottom: 1px solid rgba(28, 28, 26, 0.2); }
  .frauen-story__fact {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding: 20px 0 15px;
    border-top: 1px solid rgba(28, 28, 26, 0.2);
  }
  .frauen-story__fact dt { color: var(--frauen-muted); }
  .frauen-story__fact dd { margin: 0; font-weight: 300; font-size: 14px; letter-spacing: 0.015em; text-align: right; }
  .frauen-story__media { position: relative; min-height: 348px; overflow: hidden; background: #d9d8d3; }
  .frauen-story__media img,
  .frauen-story__media svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  @media screen and (max-width: 749px) {
    .frauen-story { grid-template-columns: 1fr; }
    .frauen-story__media { min-height: 0; aspect-ratio: 4 / 3; order: -1; }
  }
</style>
{%- endif -%}

{% schema %}
{
  "name": "Frauen historie",
  "tag": "section",
  "class": "frauen-story-section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anker (til links)", "info": "Fx historie. Link hertil med #historie" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Jakkens historie" },
    { "type": "richtext", "id": "text", "label": "Tekst", "info": "Kobl til et metafelt på produktet (ikonet ved feltet), så teksten er forskellig pr. jakke." },
    { "type": "image_picker", "id": "image", "label": "Billede", "info": "Fx et billede af tæppet eller materialet. Kan også kobles til et metafelt." },
    { "type": "range", "id": "padding_bottom", "label": "Luft under", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 160 }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fakta",
      "settings": [
        { "type": "text", "id": "label", "label": "Etiket", "default": "Tæppe" },
        { "type": "text", "id": "value", "label": "Værdi", "info": "Tom værdi = rækken vises ikke. Kan kobles til et metafelt." }
      ]
    }
  ],
  "enabled_on": { "templates": ["product"] },
  "presets": [
    {
      "name": "Frauen historie",
      "blocks": [
        { "type": "fact", "settings": { "label": "Tæppe" } },
        { "type": "fact", "settings": { "label": "Fundet" } },
        { "type": "fact", "settings": { "label": "Antal syet" } }
      ]
    }
  ]
}
{% endschema %}
