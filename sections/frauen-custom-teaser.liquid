{%- comment -%}
  Frauen custom made (forside)
  Overskrift og kort tekst til venstre, linjeknap under, og en komposition
  med to billeder stablet til venstre og ét stort til højre.
  Hvert billede er en blok med modelnavn og "fra"-pris.
{%- endcomment -%}

{{ 'frauen-card.css' | asset_url | stylesheet_tag }}

<div{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %} class="frauen-cteaser frauen-wrap" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="frauen-cteaser__head">
    {%- if section.settings.heading != blank -%}
      <h2 class="frauen-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="frauen-body frauen-cteaser__text">{{ section.settings.text }}</div>
    {%- endif -%}
  </div>

  {%- if section.settings.button_label != blank -%}
    <a href="{{ section.settings.button_link | default: '#' }}" class="frauen-btn frauen-cteaser__btn">
      <span class="frauen-btn__line"></span>
      <span class="frauen-btn__label">{{ section.settings.button_label | escape }}</span>
    </a>
  {%- endif -%}

  <div class="frauen-cteaser__grid">
    {%- for block in section.blocks limit: 3 -%}
      <div class="frauen-cteaser__item frauen-cteaser__item--{{ forloop.index }}" {{ block.shopify_attributes }}>
        {%- liquid
          assign link = block.settings.link | default: section.settings.button_link
          if forloop.index == 3
            assign sizes = '(min-width: 750px) 60vw, 100vw'
          else
            assign sizes = '(min-width: 750px) 38vw, 100vw'
          endif
        -%}
        {% render 'frauen-card',
          image: block.settings.image,
          title: block.settings.title,
          price: block.settings.price,
          url: link,
          sizes: sizes
        %}
      </div>
    {%- endfor -%}
  </div>
</div>

<style>
  .frauen-cteaser { padding-top: var(--pt); padding-bottom: var(--pb); }
  .frauen-cteaser__text { margin-top: 12px; max-width: 640px; }
  .frauen-cteaser__text p { margin: 0; }
  .frauen-cteaser__btn { margin-top: 4px; }
  .frauen-cteaser__grid {
    display: grid;
    grid-template-columns: 525fr 843fr;
    grid-template-rows: 588fr 417fr;
    gap: var(--frauen-gap);
    aspect-ratio: 1392 / 1029;
    margin-top: 40px;
  }
  .frauen-cteaser__item { min-width: 0; min-height: 0; }
  .frauen-cteaser__item--1 { grid-column: 1; grid-row: 1; }
  .frauen-cteaser__item--2 { grid-column: 1; grid-row: 2; }
  .frauen-cteaser__item--3 { grid-column: 2; grid-row: 1 / 3; }
  @media screen and (max-width: 749px) {
    /* Mobil: ét stort billede øverst og to mindre ved siden af hinanden */
    .frauen-cteaser__grid { grid-template-columns: 1fr 1fr; grid-template-rows: none; aspect-ratio: auto; row-gap: 28px; }
    .frauen-cteaser__item--1, .frauen-cteaser__item--2, .frauen-cteaser__item--3 { grid-row: auto; }
    .frauen-cteaser__item--3 { grid-column: 1 / -1; order: -1; }
    .frauen-cteaser__item--1, .frauen-cteaser__item--2 { grid-column: auto; }
  }
</style>

{% schema %}
{
  "name": "Frauen custom made",
  "tag": "section",
  "class": "frauen-cteaser-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Custom made" },
    { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>En kort tekst om custom made skal stå her.</p>" },
    { "type": "text", "id": "button_label", "label": "Knaptekst", "default": "Shop custom made" },
    { "type": "url", "id": "button_link", "label": "Knaplink", "info": "Bruges også som link på billederne, hvis de ikke har deres eget." },
    { "type": "text", "id": "anchor", "label": "Anker (til links)", "info": "Fx produktion. Link hertil med /pages/om-frauen#produktion" },
    { "type": "header", "content": "Luft" },
    { "type": "range", "id": "padding_top", "label": "Luft over", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Luft under", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 128 }
  ],
  "blocks": [
    {
      "type": "piece",
      "name": "Custom made-jakke",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Billede" },
        { "type": "text", "id": "title", "label": "Modelnavn", "default": "Modelnavn" },
        { "type": "text", "id": "price", "label": "Pris", "default": "Fra pris", "info": "Fx \"Fra 4.500 kr.\"" },
        { "type": "url", "id": "link", "label": "Link (valgfrit)" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Frauen custom made",
      "blocks": [{ "type": "piece" }, { "type": "piece" }, { "type": "piece" }]
    }
  ]
}
{% endschema %}
