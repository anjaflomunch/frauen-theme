{%- comment -%}
  Frauen 404
  Overskrift, kort tekst og linjeknapper videre.
{%- endcomment -%}

<div class="frauen-404 frauen-wrap" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <h1 class="frauen-heading">{{ section.settings.heading | escape }}</h1>
  {%- if section.settings.text != blank -%}
    <div class="frauen-statement frauen-404__text">{{ section.settings.text }}</div>
  {%- endif -%}

  <div class="frauen-404__links">
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: routes.root_url }}" class="frauen-btn frauen-btn--left">
        <span class="frauen-btn__line"></span>
        <span class="frauen-btn__label">{{ section.settings.button_label | escape }}</span>
      </a>
    {%- endif -%}
    {%- if section.settings.button_2_label != blank -%}
      <a href="{{ section.settings.button_2_link | default: routes.all_products_collection_url }}" class="frauen-btn frauen-btn--left">
        <span class="frauen-btn__line"></span>
        <span class="frauen-btn__label">{{ section.settings.button_2_label | escape }}</span>
      </a>
    {%- endif -%}
  </div>
</div>

<style>
  .frauen-404 { padding-top: var(--pt); padding-bottom: var(--pb); min-height: 50vh; }
  .frauen-404__text { margin-top: 40px; max-width: 877px; }
  .frauen-404__text p { margin: 0; }
  .frauen-404__links { display: grid; grid-template-columns: 1fr 1fr; gap: var(--frauen-gap); max-width: 877px; margin-top: 60px; }
  @media screen and (max-width: 749px) {
    .frauen-404__text { font-size: 21px; }
    .frauen-404__links { grid-template-columns: 1fr; gap: 24px; }
  }
</style>

{% schema %}
{
  "name": "Frauen 404",
  "tag": "section",
  "class": "frauen-404-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Siden findes ikke" },
    { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>En kort tekst om, at siden ikke findes, står her.</p>" },
    { "type": "text", "id": "button_label", "label": "Knap 1", "default": "Til forsiden" },
    { "type": "url", "id": "button_link", "label": "Link 1" },
    { "type": "text", "id": "button_2_label", "label": "Knap 2", "default": "Se Frauen Classics" },
    { "type": "url", "id": "button_2_link", "label": "Link 2" },
    { "type": "header", "content": "Luft" },
    { "type": "range", "id": "padding_top", "label": "Luft over", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 83 },
    { "type": "range", "id": "padding_bottom", "label": "Luft under", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 160 }
  ],
  "enabled_on": { "templates": ["404"] },
  "presets": [{ "name": "Frauen 404" }]
}
{% endschema %}
