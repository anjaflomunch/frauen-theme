{%- comment -%}
  Frauen: skrifttyper fra Shopifys font-bibliotek (hostes af Shopify, ingen Google-kald).
  Vælges under Tilpas → Temaindstillinger → Frauen.
{%- endcomment -%}
{%- liquid
  assign body = settings.frauen_font_body
  assign body_light = body | font_modify: 'weight', '300'
  assign body_regular = body | font_modify: 'weight', '400'
  assign body_medium = body | font_modify: 'weight', '500'
  assign heading = settings.frauen_font_heading
  assign heading_regular = heading | font_modify: 'weight', '400'
-%}
<style>
  {%- comment -%} Mangler en vægt i den valgte skrift, bruger browseren den nærmeste {%- endcomment -%}
  {%- if body_light -%}{{ body_light | font_face: font_display: 'swap' }}{%- endif %}
  {%- if body_regular -%}{{ body_regular | font_face: font_display: 'swap' }}{%- else -%}{{ body | font_face: font_display: 'swap' }}{%- endif %}
  {%- if body_medium -%}{{ body_medium | font_face: font_display: 'swap' }}{%- endif %}
  {{ heading | font_face: font_display: 'swap' }}
  {%- if heading_regular -%}{{ heading_regular | font_face: font_display: 'swap' }}{%- endif %}

  :root {
    --frauen-font-body: {{ body.family }}, {{ body.fallback_families }};
    --frauen-font-heading: {{ heading.family }}, {{ heading.fallback_families }};
    --frauen-font-heading-weight: {{ heading.weight }};

    --frauen-bg: {{ settings.frauen_bg }};
    --frauen-ink: {{ settings.frauen_ink }};
    --frauen-muted: {{ settings.frauen_muted }};
    --frauen-dark: {{ settings.frauen_dark }};
    --frauen-light: {{ settings.frauen_light }};
    --frauen-gap-setting: {{ settings.frauen_gap | default: 16 }}px;
  }
  {%- liquid
    assign c_bg = settings.frauen_bg
    assign c_ink = settings.frauen_ink
    assign c_dark = settings.frauen_dark
    assign c_light = settings.frauen_light
  -%}
  /* Dawns egne sider (kurv, søgning, konto, 404) får Frauens skrift og farver */
  :root,
  [class*='color-scheme'] {
    --color-background: {{ c_bg.red }},{{ c_bg.green }},{{ c_bg.blue }};
    --gradient-background: {{ c_bg }};
    --color-foreground: {{ c_ink.red }},{{ c_ink.green }},{{ c_ink.blue }};
    --color-button: {{ c_dark.red }},{{ c_dark.green }},{{ c_dark.blue }};
    --color-button-text: {{ c_light.red }},{{ c_light.green }},{{ c_light.blue }};
    --color-secondary-button: {{ c_bg.red }},{{ c_bg.green }},{{ c_bg.blue }};
    --color-secondary-button-text: {{ c_ink.red }},{{ c_ink.green }},{{ c_ink.blue }};
    --color-link: {{ c_ink.red }},{{ c_ink.green }},{{ c_ink.blue }};
    --color-badge-foreground: {{ c_ink.red }},{{ c_ink.green }},{{ c_ink.blue }};
    --color-badge-background: {{ c_bg.red }},{{ c_bg.green }},{{ c_bg.blue }};
    --color-badge-border: {{ c_ink.red }},{{ c_ink.green }},{{ c_ink.blue }};
  }
  :root {
    --font-body-family: {{ body.family }}, {{ body.fallback_families }};
    --font-body-weight: 300;
    --font-body-weight-bold: 500;
    --font-heading-family: {{ heading.family }}, {{ heading.fallback_families }};
    --font-heading-weight: {{ heading.weight }};
    --buttons-radius: 0px;
    --buttons-radius-outset: 0px;
    --inputs-radius: 0px;
    --inputs-radius-outset: 0px;
    --variant-pills-radius: 0px;
    --badge-corner-radius: 0px;
    --popup-corner-radius: 0px;
    --text-boxes-radius: 0px;
    --product-card-corner-radius: 0px;
    --collection-card-corner-radius: 0px;
    --media-radius: 0px;
  }
</style>
