{%- comment -%}
  Valutavalg: én knap pr. valuta (fx DKK, EUR, GBP, USD), ikke pr. land,
  i den rækkefølge valutaerne står i headerens indstilling.
  Klik skifter til et land med den valuta: kundens eget land, hvis det har
  valutaen, ellers det første land på listen med valutaen.
  - currency_list: '|DKK|EUR|' – de valutaer, der skal vises
  - plain: true giver knapper uden liste (mobilmenuen)
{%- endcomment -%}
{%- liquid
  assign current_currency = localization.country.currency.iso_code
  assign codes = currency_list | split: '|'
-%}
{%- unless plain -%}<ul role="list">{%- endunless -%}
{%- for code in codes -%}
  {%- if code != blank -%}
    {%- liquid
      assign target = ''
      assign symbol = ''
      if code == current_currency
        assign target = localization.country.iso_code
        assign symbol = localization.country.currency.symbol
      else
        for country in localization.available_countries
          if country.currency.iso_code == code
            assign target = country.iso_code
            assign symbol = country.currency.symbol
            break
          endif
        endfor
      endif
    -%}
    {%- unless plain -%}<li>{%- endunless -%}
    <button
      type="submit"
      name="country_code"
      value="{{ target }}"
      class="frauen-currency__option{% if code == current_currency %} is-active{% endif %}"
      {% if code == current_currency %}aria-current="true"{% endif %}
    >
      <span>{{ code }}</span>
      <span>{{ symbol }}</span>
    </button>
    {%- unless plain -%}</li>{%- endunless -%}
  {%- endif -%}
{%- endfor -%}
{%- unless plain -%}</ul>{%- endunless -%}
